{
  "name": "chatcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node apps/server/admin.mjs",
    "mcp": "node apps/server/mcp.mjs",
    "test": "node --test",
    "test:browser": "node tests/admin.browser.e2e.mjs",
    "install:opencode": "npm install --prefix packages/opencode-adapter --cache .tmp/cache/npm --no-audit --no-fund --ignore-scripts",
    "verify:opencode": "node packages/opencode-adapter/verify.mjs",
    "clean:tmp": "node scripts/clean-tmp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "diff": "8.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
